---
/*
吉祥物独立页（/mascot）的整页内容：从左侧叙事轴到最后一屏 CTA，全收在这一个文件里。

调用（页面文件只干一件事——把它塞进布局）：

  // src/pages/mascot.astro
  <BaseLayout ...>
    <MascotPageBody t={t} />
  </BaseLayout>

自上而下：开场 → 第一人称自述 → 档案 → 性格 → 表情 → 使用说明 → 伙伴 tible → 设计笔记 →
互动区 → 结尾 CTA。左边那根叙事轴的章节表是文案里的 p.chapters，章节 id 必须和下面各 section
的 id 一一对上（top / file / personality / expressions / usage / tible / design / play），
对不上那一章就点不过去。

样式在文件末尾的 <style> 里，类名统一 mp- 开头（mascot page），Astro 会自动限定作用域。
所有文案从字典 t 里取，本文件不写死任何一句中文。
*/
import type { Dict } from '../../i18n';              // 页面文案的字典类型，让 t 有类型提示
import Button from '../ui/Button.astro';            // 站内那个统一按钮（实心 / 描边两版）
import MascotPlayground from './MascotPlayground.tsx'; // 互动区那个能点着玩的 React 岛
import NarrativeRail from '../nav/NarrativeRail.tsx';   // 左侧那根叙事轴（自己接管滚动，不用父级喂事件）

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const p = t.mascotPage;        // 这一页的全部文案都在 p 里，下面模板只用 p.xxx
const states = t.mascot.states; // 表情表（和首页舞台共用同一份），互动区要把它喂给 React 岛
---

{/* 左侧叙事轴：client:idle = 页面空闲后自己接管；章节表就是 p.chapters，
    bgOf 这一页没有深底章节所以全传 0（浅色），mascot 是轴末端跟着换表情的四张小图 */}
<NarrativeRail
  client:idle
  chapters={p.chapters}
  bgOf={p.chapters.map(() => 0)}
  ariaLabel={t.ux.sectionNav}
  mascotAlt={t.mascot.companion.alt}
  mascot={{
    idle: '/img/mascot/tible-idle.webp',
    happy: '/img/mascot/tible-happy.webp',
    sleep: '/img/mascot/tible-sleep.webp',
    alert: '/img/mascot/tible-alert.webp',
  }}
/>

<main id="main" class="mp">
  <!-- ---------------- hero：开场 ---------------- -->
  {/* 左边：小标 + 大名字 + 罗马字 + 一句 tagline + 三行自述 + 回首页按钮。
      data-anim / data-delay 是全站入场动画的开关和出场间隔，动它只影响节奏；先出现的是名字。 */}
  {/* 右边：立绘 + 右下角一行编号，图走 fetchpriority="high"，因为这是第一眼看到的东西 */}
  <section class="mp-hero" id="top">
    <div class="shell mp-hero__grid">
      <div class="mp-hero__copy">
        <p class="mono mp-hero__kicker"><span class="dot" aria-hidden="true"></span>{p.hero.kicker}</p>
        <h1 class="mp-hero__name display" data-anim="fade">{p.hero.name}</h1>
        <p class="mp-hero__roman mono">{p.hero.roman}</p>
        <p class="mp-hero__tagline h2" data-anim="fade" data-delay="0.05">{p.hero.tagline}</p>
        <div class="mp-hero__intro" data-anim="fade" data-delay="0.1">
          {p.hero.intro.map((para) => <p class="body-text">{para}</p>)}
        </div>
        <div class="mp-hero__actions" data-anim="fade" data-delay="0.14">
          <Button href={t.path.home} label={p.hero.back} variant="outline" />
        </div>
      </div>

      <figure class="mp-hero__figure">
        <img src="/img/mascot/hiromi-wave.webp" alt={p.hero.portraitAlt} width={720} height={720} fetchpriority="high" decoding="async" />
        <figcaption class="mono-sm">HIROMI / 01</figcaption>
      </figure>
    </div>
  </section>

  <!-- ---------------- stanza：第一人称自述 ---------------- -->
  {/* 左边一个竖排小标签，右边一行行大字；第一行加 is-first 加粗，当开场白。
      句子本身在字典里写好换行，这里不拆句。 */}
  <section class="mp-stanza" aria-label={p.stanza.label}>
    <div class="shell mp-stanza__inner">
      <span class="mono mp-stanza__label">{p.stanza.label}</span>
      <div class="mp-stanza__lines">
        {p.stanza.lines.map((line, i) => <p class:list={['mp-stanza__line', { 'is-first': i === 0 }]}>{line}</p>)}
      </div>
    </div>
  </section>

  <!-- ---------------- file：档案表 ---------------- -->
  {/* 左边标题、右边一排「字段名 / 值」；用 dl 而不是 div，读屏能听出这是成对的档案项 */}
  <section class="mp-block" id="file">
    <div class="shell mp-split">
      <header class="mp-head">
        <span class="mono mp-head__label">{p.file.label}</span>
        <h2 class="h2">{p.file.title}</h2>
      </header>

      <dl class="mp-file" data-anim="stagger">
        {
          p.file.rows.map((row) => (
            <div class="mp-file__row">
              <dt class="mono">{row.k}</dt>
              <dd>{row.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ---------------- personality：性格三条 ---------------- -->
  {/* 用 ol：这一组是有先后的三条，编号 item.no 是文案里写死的「01/02/03」，不是自动生成 */}
  <section class="mp-block mp-block--tight" id="personality">
    <div class="shell">
      <header class="mp-head mp-head--wide" data-anim="fade">
        <span class="mono mp-head__label">{p.personality.label}</span>
        <h2 class="h2">{p.personality.title}</h2>
      </header>

      <ol class="mp-list" data-anim="stagger">
        {
          p.personality.items.map((item) => (
            <li>
              <span class="mono mp-list__no">{item.no}</span>
              <h3 class="mp-list__title">{item.title}</h3>
              <p class="mp-list__body">{item.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ---------------- expressions：表情一览 ---------------- -->
  {/* 一格一格的表情卡：图 + 编号 + 名字 + 一句说明。图按 item.id 拼路径，
      所以新增表情只要往字典里加一项、把图按同名放进 /img/mascot/，这里不用改 */}
  <section class="mp-block mp-block--shade" id="expressions">
    <div class="shell">
      <header class="mp-head mp-head--wide" data-anim="fade">
        <span class="mono mp-head__label">{p.expressions.label}</span>
        <h2 class="h2">{p.expressions.title}</h2>
        <p class="lead mp-head__lede">{p.expressions.lede}</p>
      </header>

      <ul class="mp-exp" data-anim="stagger">
        {
          p.expressions.items.map((item) => (
            <li class="mp-exp__item">
              <div class="mp-exp__frame">
                <img src={`/img/mascot/hiromi-${item.id}.webp`} alt={`${p.hero.name} · ${item.name}`} width={420} height={420} loading="lazy" decoding="async" />
              </div>
              <div class="mp-exp__meta">
                <span class="mono mp-exp__code">{item.id.toUpperCase()}</span>
                <h3 class="mp-exp__name">{item.name}</h3>
                <p class="mp-exp__note">{item.note}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ---------------- usage：使用说明 ---------------- -->
  {/* 两列的说明清单，拆成「什么场合 / 怎么用」；宽屏才分两列（见文件末尾的 760px 断点） */}
  <section class="mp-block" id="usage">
    <div class="shell">
      <header class="mp-head mp-head--wide" data-anim="fade">
        <span class="mono mp-head__label">{p.usage.label}</span>
        <h2 class="h2">{p.usage.title}</h2>
        <p class="lead mp-head__lede">{p.usage.lede}</p>
      </header>

      <ul class="mp-usage" data-anim="stagger">
        {
          p.usage.items.map((item) => (
            <li>
              <span class="mono mp-usage__code">{item.code}</span>
              <h3 class="mp-usage__title">{item.title}</h3>
              <p class="mp-usage__body">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ---------------- companion: tible ---------------- -->
  {/* 这一屏故意用深底（mp-block--dark on-dark）：全页只有这一块是黑的，用来把伙伴单独拎出来。
      四张图并排是装饰，所以整块 aria-hidden，真正的说明放在下面那行 sr-only 里 */}
  <section class="mp-block mp-block--dark on-dark" id="tible">
    <div class="shell mp-companion">
      <div class="mp-companion__copy">
        <span class="mono mp-head__label mp-head__label--orange">{p.companion.label}</span>
        <h2 class="h2">{p.companion.title}</h2>
        {p.companion.body.map((para) => <p class="body-text">{para}</p>)}

        <dl class="mp-companion__traits">
          {
            p.companion.traits.map((tr) => (
              <div>
                <dt class="mono">{tr.k}</dt>
                <dd>{tr.v}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="mp-companion__figures" aria-hidden="true">
        <img src="/img/mascot/tible-idle.webp" alt="" width={200} height={200} loading="lazy" decoding="async" />
        <img src="/img/mascot/tible-happy.webp" alt="" width={200} height={200} loading="lazy" decoding="async" />
        <img src="/img/mascot/tible-sleep.webp" alt="" width={200} height={200} loading="lazy" decoding="async" />
        <img src="/img/mascot/tible-alert.webp" alt="" width={200} height={200} loading="lazy" decoding="async" />
      </div>
      <p class="sr-only">{p.companion.alt}</p>
    </div>
  </section>

  <!-- ---------------- design notes：设计笔记 ---------------- -->
  {/* 左边几段话、右边几条「术语 / 解释」；说明这只吉祥物为什么长这样，是给人看的过程记录 */}
  <section class="mp-block" id="design">
    <div class="shell mp-split">
      <header class="mp-head">
        <span class="mono mp-head__label">{p.design.label}</span>
        <h2 class="h2">{p.design.title}</h2>
      </header>

      <div class="mp-design">
        <div class="mp-design__text">
          {p.design.paragraphs.map((para) => <p class="body-text">{para}</p>)}
        </div>
        <dl class="mp-design__notes">
          {
            p.design.notes.map((n) => (
              <div>
                <dt class="mono">{n.k}</dt>
                <dd>{n.v}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- ---------------- play：互动区 ---------------- -->
  {/* 点着玩的那块是 React 岛：client:visible = 滚到这一屏才开始下载 React，
      省掉首屏的脚本。states 在这里就地转成 MascotPlayground 要的形状，只取它用得到的字段 */}
  <section class="mp-block mp-block--shade" id="play">
    <div class="shell mp-play">
      <div class="mp-play__copy">
        <span class="mono mp-head__label">{p.play.label}</span>
        <h2 class="h2">{p.play.title}</h2>
        <p class="lead">{p.play.hint}</p>
      </div>

      <div class="mp-play__stage">
        <MascotPlayground
          client:visible
          items={states.map((s) => ({ id: s.id, name: s.label, note: s.note, image: s.image }))}
          lines={p.play.lines}
          hint={p.play.hint}
          reset={p.play.reset}
          alt={t.mascot.alt}
        />
      </div>
    </div>
  </section>

  <!-- ---------------- cta：结尾 ---------------- -->
  {/* 一句收尾 + 一个回首页的实心按钮，页到这儿结束 */}
  <section class="mp-cta">
    <div class="shell mp-cta__inner" data-anim="fade">
      <div>
        <h2 class="h2">{p.cta.title}</h2>
        <p class="body-text">{p.cta.body}</p>
      </div>
      <Button href={p.cta.button.href} label={p.cta.button.label} variant="solid" />
    </div>
  </section>
</main>

<style>
  /* 本页样式。.mp- 开头的是这一页私有的；.h2 / .body-text / .mono / .lead 是全局排版类，这里只做少量覆盖。
     Astro 会把下面每条选择器都加上本组件的作用域，所以可以放心用 .dot、li 这种短名字。 */
  /* ---------------- hero ---------------- */
  .mp-hero {
    /* 顶上空出固定导航的高度（约 96px），大屏再按 14vh 多让一点，标题才不会顶着导航 */
    padding-top: clamp(96px, 14vh, 150px);
    padding-bottom: clamp(3rem, 7vw, 6rem);
    position: relative;
    overflow: clip;
    border-bottom: 1px solid var(--ink-12);
  }

  .mp-hero__grid {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }

  .mp-hero__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink-56);
    margin-bottom: 1rem;
    font-size: 0.5625rem;
  }

  /* 标题前那颗橙点。5px 是「看得见但不抢字」的大小，圆到极限就是正圆 */
  .dot {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--orange);
  }

  .mp-hero__name {
    /* 名字是全页最大的字：行距压到 0.95、字距收紧 0.04em，
       中文大字的笔画之间本来就是空的，按默认行距会散成一团 */
    font-size: clamp(3rem, 9vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .mp-hero__roman {
    color: var(--ink-38);
    margin-top: 0.75rem;
    font-size: 0.625rem;
  }

  .mp-hero__tagline {
    /* 一句话 tagline 限宽 20ch：一句一行，别让它在宽屏上拉成一条长线 */
    margin-top: clamp(1.25rem, 3vw, 2rem);
    font-size: clamp(1.25rem, 2.4vw, 1.875rem);
    max-width: 20ch;
  }

  .mp-hero__intro {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
    max-width: 46ch;
  }

  .mp-hero__actions {
    margin-top: 1.75rem;
  }

  .mp-hero__figure {
    margin: 0;
    position: relative;
    justify-self: center;
    width: min(78vw, 520px);
  }

  .mp-hero__figure img {
    width: 100%;
    height: auto;
  }

  .mp-hero__figure figcaption {
    position: absolute;
    bottom: 0;
    right: 0;
    color: var(--ink-38);
    font-size: 0.5rem;
  }

  /* ---------------- stanza ---------------- */
  /* 奶白偏灰的第二层底色，用来把这一屏和白色段落分开；全站的分层就靠 --cream-2 这一级 */
  .mp-stanza {
    background: var(--cream-2);
    border-bottom: 1px solid var(--ink-12);
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }

  .mp-stanza__inner {
    display: grid;
    gap: clamp(1rem, 2.5vw, 2.5rem);
    align-items: start;
  }

  .mp-stanza__label {
    color: var(--ink-38);
    font-size: 0.5625rem;
    padding-top: 0.5rem;
  }

  .mp-stanza__lines {
    display: grid;
    gap: 0.35rem;
    /* 左边那道橙线就是「这是引用/自述」的记号；行距靠 lines 的 1.75 撑开，句间只留 0.35rem */
    border-left: 2px solid var(--orange);
    padding-left: clamp(1rem, 2.5vw, 1.75rem);
  }

  .mp-stanza__line {
    font-size: clamp(1.0625rem, 1.7vw, 1.3125rem);
    line-height: 1.75;
    letter-spacing: -0.005em;
    color: var(--ink-70);
    font-weight: 500;
  }

  .mp-stanza__line.is-first {
    color: var(--ink);
    font-weight: 800;
  }

  @media (min-width: 900px) {
    .mp-stanza__inner {
      grid-template-columns: minmax(0, 0.28fr) minmax(0, 1fr);
    }
  }

  /* ---------------- blocks ---------------- */
  .mp-block {
    padding-block: clamp(3.5rem, 8vw, 7rem);
    border-bottom: 1px solid var(--ink-12);
  }

  .mp-block--tight {
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .mp-block--shade {
    background: var(--cream-2);
  }

  .mp-block--dark {
    /* 不用纯黑：偏暖的 #141210 跟奶白纸放一起不刺眼，也压得住下面的橙色 */
    background: #141210;
    color: var(--cream);
    border-bottom: 0;
  }

  .mp-head {
    display: grid;
    gap: 0.9rem;
    align-content: start;
  }

  .mp-head--wide {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
    max-width: 60ch;
  }

  .mp-head__label {
    color: var(--ink-38);
    font-size: 0.5625rem;
  }

  .mp-head__label--orange {
    color: var(--orange);
  }

  .mp-head__lede {
    margin-top: 0.5rem;
    max-width: 48ch;
  }

  .mp-split {
    display: grid;
    gap: clamp(1.5rem, 4vw, 4rem);
  }

  .mp-file {
    display: grid;
    border-top: 1px solid var(--ink-12);
  }

  .mp-file__row {
    display: grid;
    grid-template-columns: minmax(6rem, 0.4fr) 1fr;
    gap: 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--ink-12);
    align-items: baseline;
  }

  .mp-file__row dt {
    color: var(--ink-56);
    font-size: 0.5625rem;
  }

  .mp-file__row dd {
    font-size: var(--fs-small);
  }

  .mp-list {
    display: grid;
    gap: 1.25rem;
    border-top: 1px solid var(--ink-12);
    padding-top: 1.25rem;
  }

  .mp-list li {
    display: grid;
    gap: 0.4rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--ink-08);
  }

  .mp-list__no {
    color: var(--orange);
    font-size: 0.5625rem;
  }

  .mp-list__title {
    font-size: clamp(1.125rem, 1.7vw, 1.375rem);
    font-weight: 800;
  }

  .mp-list__body {
    font-size: var(--fs-small);
    color: var(--ink-56);
    line-height: 1.8;
    max-width: 46ch;
  }

  /* expressions */
  .mp-exp {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  /* 表情卡的框。aspect-ratio: 1 让每一格都是正方形，图片一律 contain 居中，不会把脸裁掉 */
  .mp-exp__frame {
    border: 1px solid var(--ink-12);
    background: var(--cream);
    display: grid;
    place-items: center;
    padding: 1rem;
    aspect-ratio: 1;
    transition: border-color 300ms var(--ease-out);
  }

  .mp-exp__item:hover .mp-exp__frame {
    border-color: var(--ink-38);
  }

  .mp-exp__frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 520ms var(--ease-out);
  }

  .mp-exp__item:hover .mp-exp__frame img {
    /* 悬停只抬 4px、放大 2%：幅度再大就像在跳，这里只想给一点「被拿起来看」的手感 */
    transform: translateY(-4px) scale(1.02);
  }

  .mp-exp__meta {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.85rem;
  }

  .mp-exp__code {
    color: var(--orange);
    font-size: 0.5rem;
  }

  .mp-exp__name {
    font-size: 1rem;
    font-weight: 700;
  }

  .mp-exp__note {
    font-size: 0.8125rem;
    color: var(--ink-56);
    line-height: 1.7;
  }

  /* usage */
  .mp-usage {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--ink-12);
  }

  .mp-usage li {
    display: grid;
    gap: 0.4rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--ink-12);
  }

  .mp-usage__code {
    color: var(--orange);
    font-size: 0.5rem;
  }

  .mp-usage__title {
    font-size: 1.0625rem;
    font-weight: 700;
  }

  .mp-usage__body {
    font-size: var(--fs-small);
    color: var(--ink-56);
    line-height: 1.8;
    max-width: 52ch;
  }

  /* companion */
  .mp-companion {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .mp-companion__copy {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .mp-companion__copy .body-text {
    color: rgba(255, 249, 241, 0.66);
    max-width: 46ch;
  }

  .mp-companion__traits {
    display: grid;
    gap: 0.9rem;
    margin-top: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 249, 241, 0.16);
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
  }

  .mp-companion__traits dt {
    color: var(--orange);
    font-size: 0.5rem;
    margin-bottom: 0.3rem;
  }

