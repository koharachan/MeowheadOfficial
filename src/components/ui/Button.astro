---
interface Props {
  href: string;
  label: string;
  variant?: 'solid' | 'outline' | 'quiet';
  arrow?: boolean;
  class?: string;
  dataAttr?: string;
}

const { href, label, variant = 'solid', arrow = true, class: cls = '', dataAttr } = Astro.props;
---

<a href={href} class:list={['btn', `btn--${variant}`, cls]} data-cta={dataAttr}>
  <span class="btn__label">{label}</span>
  {
    arrow && (
      <span class="btn__arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M4 12h15M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    )
  }
</a>

<style>
  .btn {
    --btn-bg: var(--ink);
    --btn-fg: var(--cream);
    --btn-bd: transparent;

    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    padding: 0.95em 1.6em;
    border-radius: 999px;
    border: 1px solid var(--btn-bd);
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1;
    white-space: nowrap;
    transition:
      background-color 260ms var(--ease-out),
      color 260ms var(--ease-out),
      border-color 260ms var(--ease-out),
      transform 260ms var(--ease-out);
  }

  .btn__label {
    position: relative;
    z-index: 1;
  }

  .btn__arrow {
    display: inline-flex;
    transition: transform 300ms var(--ease-out);
  }

  .btn:hover .btn__arrow {
    transform: translateX(4px);
  }

  .btn--solid:hover {
    background: var(--orange);
    color: var(--cream);
  }

  .btn--outline {
    --btn-bg: transparent;
    --btn-fg: var(--ink);
    --btn-bd: var(--ink-20);
  }

  .btn--outline:hover {
    --btn-bd: var(--ink);
    background: var(--ink);
    color: var(--cream);
  }

  .btn--quiet {
    --btn-bg: transparent;
    --btn-fg: var(--ink);
    --btn-bd: transparent;
    padding-inline: 0;
    border-radius: 0;
  }

  .btn--quiet:hover {
    color: var(--orange);
  }

  .btn--quiet .btn__label::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.35em;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 300ms var(--ease-out);
  }

  .btn--quiet:hover .btn__label::after {
    transform: scaleX(1);
  }
</style>
