---
import type { Dict } from '../../i18n';
import SectionField from '../ui/SectionField.astro';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const w = t.why;
---

<section class="why on-dark" id="why">
  <SectionField no={w.no} tone="dark" align="left" />
  <div class="shell">
    <header class="why__head" data-anim="fade">
      <span class="mono why__no">{w.no}</span>
      <span class="mono why__label">{w.label}</span>
    </header>

    <h2 class="why__title display" data-anim="lines">
      <span class="line-mask"><span>{w.title}</span></span>
    </h2>

    <ol class="why__list">
      {
        w.items.map((item) => (
          <li class="why__item" data-anim="fade">
            <span class="why__letter mono" data-scrub data-scrub-y="26">{item.no}</span>
            <h3 class="why__item-title">{item.title}</h3>
            <p class="why__item-body">{item.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .why {
    position: relative;
    background: #141210;
    color: var(--cream);
    padding-block: clamp(4.5rem, 10vw, 9rem);
    overflow: clip;
  }

  .why__head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    color: rgba(255, 249, 241, 0.45);
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
  }

  .why__no {
    color: var(--orange);
  }

  .why__title {
    font-size: var(--fs-h1);
    font-weight: 900;
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
    max-width: 14ch;
  }

  .why__list {
    display: grid;
    border-top: 1px solid rgba(255, 249, 241, 0.16);
  }

  .why__item {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: clamp(1rem, 3vw, 2.5rem);
    row-gap: 0.6rem;
    padding-block: clamp(1.5rem, 3.4vw, 2.5rem);
    border-bottom: 1px solid rgba(255, 249, 241, 0.16);
    align-items: start;
  }

  .why__letter {
    color: var(--orange);
    font-size: 0.6875rem;
    padding-top: 0.55em;
  }

  .why__item-title {
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .why__item-body {
    grid-column: 2;
    color: rgba(255, 249, 241, 0.6);
    font-size: var(--fs-small);
    line-height: 1.8;
    max-width: 46ch;
  }

  @media (min-width: 900px) {
    .why__item {
      grid-template-columns: 2.5rem minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
    }

    .why__item-title {
      font-size: clamp(1.5rem, 2.4vw, 2rem);
    }

    .why__item-body {
      grid-column: 3;
    }
  }
</style>
