---
import type { Dict } from '../../i18n';
import SectionHead from '../ui/SectionHead.astro';
import SectionField from '../ui/SectionField.astro';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const p = t.process;
---

<section class="proc section" id="process">
  <SectionField no={p.no} lines={4} />
  <div class="shell">
    <SectionHead no={p.no} label={p.label} title={p.title} lede={p.lede} />

    <ol class="proc__steps" data-anim="stagger">
      {
        p.steps.map((step) => (
          <li class="step">
            <div class="step__rail" aria-hidden="true" data-scrub data-scrub-y="14">
              <span class="step__dot" data-scrub data-scrub-rotate="90"></span>
            </div>
            <span class="step__no mono">{step.no}</span>
            <h3 class="step__title">{step.title}</h3>
            <p class="step__body">{step.body}</p>
            <div class="step__out">
              <span class="mono step__out-label">{p.deliverableLabel}</span>
              <span class="step__out-value">{step.deliverable}</span>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .proc__steps {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--ink-12);
  }

  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 1rem;
    row-gap: 0.65rem;
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
    border-bottom: 1px solid var(--ink-12);
    position: relative;
  }

  .step__rail {
    grid-column: 1 / -1;
    display: none;
  }

  .step__no {
    color: var(--orange);
    font-size: 0.6875rem;
    padding-top: 0.4em;
  }

  .step__title {
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .step__body {
    grid-column: 2;
    color: var(--ink-56);
    font-size: var(--fs-small);
    line-height: 1.8;
    max-width: 40ch;
  }

  .step__out {
    grid-column: 2;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
    padding-top: 0.35rem;
  }

  .step__out-label {
    color: var(--ink-38);
    font-size: 0.5rem;
  }

  .step__out-value {
    font-size: var(--fs-small);
    font-weight: 600;
    border-bottom: 1px solid var(--ink-20);
    padding-bottom: 0.1em;
  }

  @media (min-width: 900px) {
    .proc__steps {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      border-top: 0;
      column-gap: clamp(1rem, 2vw, 2rem);
    }

    .step {
      grid-template-columns: 1fr;
      border-bottom: 0;
      padding-top: 0;
      row-gap: 0.8rem;
    }

    .step__rail {
      display: block;
      position: relative;
      height: 1px;
      background: var(--ink-12);
      margin-bottom: 1.25rem;
    }

    .step__dot {
      position: absolute;
      left: 0;
      top: 50%;
      width: 7px;
      height: 7px;
      border-radius: 999px;
      border: 1px solid var(--ink-38);
      background: var(--cream);
      transform: translateY(-50%);
      transition:
        background-color 300ms var(--ease-out),
        border-color 300ms var(--ease-out),
        transform 300ms var(--ease-out);
    }

    .step:hover .step__dot {
      background: var(--orange);
      border-color: var(--orange);
      transform: translateY(-50%) scale(1.35);
    }

    .step__no {
      font-size: 0.6875rem;
      padding-top: 0;
    }

    .step__title {
      font-size: clamp(1.125rem, 1.5vw, 1.375rem);
    }

    .step__body,
    .step__out {
      grid-column: 1;
    }

    .step__body {
      font-size: 0.8125rem;
      line-height: 1.75;
    }

    .step__out {
      margin-top: auto;
      padding-top: 1rem;
      flex-direction: column;
      gap: 0.3rem;
    }
  }
</style>
