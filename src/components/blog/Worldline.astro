---
import type { Dict } from '../../i18n';
import { worldline } from '../../data/worldline';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const lang = t.lang;
const items = worldline;
---

<section class="wl" aria-labelledby="wl-title">
  <div class="wl__head">
    <p class="mono wl__label">WORLDLINE / 世界线</p>
    <h2 class="h3 wl__title" id="wl-title">
      {lang === 'en' ? 'Every log is a coordinate.' : lang === 'yue' ? '每篇日誌都係一個座標。' : '每篇日志都是一个坐标。'}
    </h2>
    <p class="wl__lede">
      {
        lang === 'en'
          ? 'The company, the terminal, the globe, the mascot — same line. Each post below hangs on one of these five points.'
          : lang === 'yue'
            ? '公司、終端、地球、吉祥物——同一條線。下面每篇日誌都掛喺呢五個點其中一個度。'
            : '公司、终端、地球、吉祥物——同一条线。下面每篇日志都挂在其中一点上。'
      }
    </p>
  </div>

  <ol class="wl__track">
    {
      items.map((m) => (
        <li class="wl__item">
          <span class="mono wl__no">{m.no}</span>
          <span class="wl__dot" aria-hidden="true" />
          <time class="mono wl__date" datetime={m.date}>
            {m.date.replace(/-/g, '.')}
          </time>
          <h3 class="wl__name">{m[lang].title}</h3>
          <span class={['mono wl__tag', { 'is-set': m[lang].tag === '设定' || m[lang].tag === '設定' || m[lang].tag === 'Design' }]}>
            {m[lang].tag}
          </span>
          <p class="wl__body">{m[lang].body}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .wl {
    margin: clamp(2.5rem, 5vw, 4rem) 0 clamp(2.5rem, 5vw, 4rem);
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    border-top: var(--hair);
  }

  .wl__head {
    display: grid;
    gap: 0.65rem;
    margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .wl__label {
    color: var(--orange);
    font-size: 0.5rem;
  }

  .wl__title {
    margin: 0;
  }

  .wl__lede {
    max-width: 54ch;
    color: var(--ink-56);
    font-size: var(--fs-small);
    line-height: 1.75;
  }

  .wl__track {
    display: grid;
    gap: 1px;
    background: var(--cream);
  }

  .wl__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.4rem 0.9rem;
    padding: clamp(1rem, 1.8vw, 1.4rem) clamp(0.9rem, 1.6vw, 1.4rem);
    background: var(--surface-0);
    align-items: start;
  }

  .wl__no {
    color: var(--orange);
    font-size: 0.5rem;
    letter-spacing: 0.12em;
    padding-top: 0.15rem;
  }

  .wl__dot {
    display: none;
  }

  .wl__date {
    color: var(--ink-38);
    font-size: 0.5rem;
    letter-spacing: 0.1em;
    grid-column: 2;
  }

  .wl__name {
    grid-column: 2;
    font-family: var(--font-cjk);
    font-size: var(--fs-h4);
    font-weight: 700;
    line-height: 1.4;
  }

  .wl__tag {
    grid-column: 2;
    justify-self: start;
    padding: 0.15em 0.45em;
    border-radius: 4px;
    background: var(--surface-2);
    color: var(--ink-38);
    font-size: 0.4375rem;
  }

  .wl__tag.is-set {
    background: var(--orange-soft);
    color: var(--orange);
  }

  .wl__body {
    grid-column: 2;
    color: var(--ink-56);
    font-size: 0.8125rem;
    line-height: 1.7;
    text-wrap: pretty;
  }

  @media (min-width: 920px) {
    .wl__track {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .wl__item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      position: relative;
      padding-top: 1.75rem;
    }

    /* 轴：一条横线串起五个点 */
    .wl__item::before {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: 0.95rem;
      height: 1px;
      background: var(--ink-12);
    }

    .wl__dot {
      display: block;
      position: absolute;
      left: clamp(0.9rem, 1.6vw, 1.4rem);
      top: 0.55rem;
      width: 9px;
      height: 9px;
      border-radius: 999px;
      background: var(--surface-0);
      box-shadow: inset 0 0 0 1.5px var(--ink-20);
    }

    .wl__item:first-child .wl__dot {
      background: var(--orange);
      box-shadow: none;
    }

    .wl__no,
    .wl__date,
    .wl__name,
    .wl__tag,
    .wl__body {
      grid-column: auto;
    }
  }
</style>
