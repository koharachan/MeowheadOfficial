---
import type { Dict } from '../../i18n';
import type { Post } from '../../data/posts';

interface Props {
  t: Dict;
  posts: Post[];
}
const { t, posts } = Astro.props;
const lang = t.lang;
---

<ul class="plist" data-anim="stagger">
  {
    posts.map((post) => {
      const copy = lang === 'zh' ? post.zh : post.en;
      const href = `${t.path.blog}${post.slug}/`;
      return (
        <li class="plist__item">
          <a class="plist__link" href={href}>
            <div class="plist__side">
              <time class="mono plist__date" datetime={post.date}>
                {post.date.replace(/-/g, '.')}
              </time>
              <span class="mono plist__tag">{post.tag[lang]}</span>
              <span class="mono plist__read">
                {post.readMinutes} {t.blog.readUnit}
              </span>
            </div>

            <div class="plist__main">
              <h2 class="plist__title">{copy.title}</h2>
              <p class="plist__excerpt">{copy.excerpt}</p>
            </div>

            <span class="plist__arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M4 12h15M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .plist {
    display: grid;
    border-top: 1px solid var(--ink-12);
  }

  .plist__item {
    border-bottom: 1px solid var(--ink-12);
  }

  .plist__link {
    position: relative;
    display: grid;
    gap: 0.75rem;
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
    padding-inline: clamp(0rem, 1.6vw, 1.5rem);
    transition: background-color 380ms var(--ease-out);
  }

  .plist__side {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .plist__main {
    display: grid;
    gap: 0.65rem;
  }

  .plist__link::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--orange);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 420ms var(--ease-out);
  }

  .plist__link:hover {
    background: var(--cream-2);
  }

  .plist__link:hover::before {
    transform: scaleY(1);
  }

  .plist__meta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--ink-38);
  }

  .plist__read {
    font-size: 0.5rem;
    color: var(--ink-38);
    letter-spacing: 0.1em;
  }

  .plist__date {
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    font-variant-numeric: tabular-nums;
  }

  .plist__tag {
    font-size: 0.5rem;
    padding: 0.28em 0.55em;
    border: 1px solid var(--ink-20);
    border-radius: 999px;
    color: var(--ink-56);
  }

  .plist__title {
    font-size: clamp(1.25rem, 2.1vw, 1.75rem);
    font-weight: 800;
    letter-spacing: -0.015em;
    line-height: 1.35;
    max-width: 26ch;
    transition: color 260ms var(--ease-out);
  }

  .plist__link:hover .plist__title {
    color: var(--orange);
  }

  .plist__excerpt {
    font-size: var(--fs-small);
    color: var(--ink-56);
    line-height: 1.8;
    max-width: 56ch;
  }

  .plist__arrow {
    display: inline-flex;
    align-self: center;
    justify-self: end;
    color: var(--ink-38);
    transition:
      transform 320ms var(--ease-out),
      color 260ms var(--ease-out);
  }

  .plist__link:hover .plist__arrow {
    transform: translateX(5px);
    color: var(--orange);
  }

  @media (min-width: 900px) {
    .plist__link {
      grid-template-columns: 172px minmax(0, 1fr) 32px;
      align-items: start;
      column-gap: clamp(1.5rem, 3vw, 2.75rem);
      padding-block: clamp(1.75rem, 2.6vw, 2.5rem);
    }

    .plist__side {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
      padding-top: 0.35rem;
    }

    .plist__arrow {
      align-self: start;
      margin-top: 0.35rem;
    }
  }
</style>
