    <div class="panel-title">Contact</div>
    <div class="panel-body">
      <table class="data" cellpadding="0" cellspacing="0">
        <tr>
          <th>Office</th>
          <td>Room F469, Zone B, Building 5, No. 8 Baiwang West Road, Wujiang District, Shaoguan, Guangdong (office use only)</td>
        </tr>
        <tr>
          <th>Credit code</th>
