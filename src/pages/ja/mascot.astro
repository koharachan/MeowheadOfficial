---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import MascotPageBody from '../../components/mascot/MascotPageBody.astro';
import { getDict } from '../../i18n';

const t = getDict('ja');
---

<Base lang="ja" title={t.mascotPage.meta.title} description={t.mascotPage.meta.description} altPath="/en/mascot/">
  <Nav t={t} isHome={false} />
  <MascotPageBody t={t} />
  <Footer t={t} isHome={false} />
</Base>
