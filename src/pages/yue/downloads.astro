---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import SectionField from '../../components/ui/SectionField.astro';
import { getDict } from '../../i18n';

const t = getDict('yue');
const d = t.downloads;
---

<Base lang="yue" title={`${d.title} · ${t.brand.name}`} description={d.lede} altPath="/en/downloads/">
  <Nav t={t} isHome={false} />

  <main id="main" class="dl">
    <SectionField no="D" align="right" />

    <div class="shell">
      <header class="dl__head">
        <div class="dl__meta" data-anim="fade">
          <span class="mono dl__no">DL</span>
          <span class="dl__rule" aria-hidden="true"></span>
          <span class="mono">{d.label}</span>
        </div>
        <h1 class="h1 dl__title" data-stream data-anim="fade" data-delay="0.05">{d.title}</h1>
        <p class="lead dl__lede" data-anim="fade" data-delay="0.1">{d.lede}</p>
      </header>

      <ul class="dl__list" data-anim="stagger">
        {
          d.items.map((item, i) => (
            <li class="dl__item">
              <span class="mono dl__idx">{String(i + 1).padStart(2, '0')}</span>

              <div class="dl__body">
                <h2 class="dl__name">{item.name}</h2>
                <p class="dl__note">{item.note}</p>
                <div class="dl__chips">
                  <span class="mono">{item.format}</span>
                  <span class="mono">{item.size}</span>
                </div>
              </div>

              <a class="dl__btn" href={item.href} download>
                <span>{d.action}</span>
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                  <path d="M12 4v11M7.5 10.5L12 15l4.5-4.5M5 19h14" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="dl__note-foot mono-sm" data-anim="fade">{d.note}</p>

      <section class="dl__license" data-anim="fade">
        <h2 class="h3">{d.licenseTitle}</h2>
        <ul>
          {d.license.map((line) => <li>{line}</li>)}
          <li class="dl__license-doc">
            <a href="/LICENSE.txt" target="_blank" rel="noopener">LICENSE.txt →</a>
            <span class="dl__license-cc">
              · <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">文章 CC BY 4.0</a>
            </span>
          </li>
        </ul>
      </section>
    </div>
  </main>

  <Footer t={t} isHome={false} />
</Base>

<style>
  .dl {
    position: relative;
    padding-top: clamp(110px, 16vh, 180px);
    padding-bottom: clamp(4rem, 9vw, 7rem);
    overflow: clip;
    min-height: 100svh;
  }

  .dl > .shell > * { max-width: 1180px; margin-inline: auto; }
  .dl__head { display: grid; gap: 1rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .dl__meta { display: flex; align-items: center; gap: 0.9rem; color: var(--ink-56); }
  .dl__no { color: var(--orange); }
  .dl__rule { width: clamp(28px, 5vw, 64px); height: 1px; background: var(--ink-20); }
  .dl__title { max-width: 20ch; }
  .dl__lede { max-width: 52ch; }

  .dl__list { display: grid; border-top: var(--hair); }

  .dl__item {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: clamp(1rem, 2.4vw, 2rem);
    align-items: center;
    padding-block: clamp(1.25rem, 2.6vw, 1.9rem);
    border-bottom: var(--hair);
    transition: background-color 360ms var(--ease-out);
  }

  .dl__item::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 2px;
    background: var(--orange);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 420ms var(--ease-out);
  }

  .dl__item:hover { background: var(--cream-2); }
  .dl__item:hover::before { transform: scaleY(1); }

  .dl__idx { color: var(--ink-38); font-size: 0.5625rem; align-self: start; padding-top: 0.45em; }

  .dl__body { display: grid; gap: 0.45rem; }

  .dl__name { font-size: clamp(1.0625rem, 1.7vw, 1.375rem); font-weight: 800; letter-spacing: -0.01em; }

  .dl__note { font-size: var(--fs-small); color: var(--ink-56); line-height: 1.7; max-width: 52ch; }

  .dl__chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }

  .dl__chips span {
    font-size: 0.5rem;
    padding: 0.28em 0.55em;
    border: 1px solid var(--ink-12);
    border-radius: 999px;
    color: var(--ink-56);
  }

  .dl__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.75em 1.2em;
    border-radius: 999px;
    border: 1px solid var(--ink);
    font-size: var(--fs-small);
    font-weight: 600;
    white-space: nowrap;
    transition:
      background-color 240ms var(--ease-out),
      color 240ms var(--ease-out),
      border-color 240ms var(--ease-out);
  }

  .dl__btn:hover { background: var(--ink); color: var(--cream); }

  .dl__note-foot {
    margin-top: 1.5rem;
    color: var(--ink-38);
    text-transform: none;
    letter-spacing: 0.05em;
    font-size: 0.625rem;
  }

  .dl__license {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: clamp(1.5rem, 3vw, 2rem);
    border-top: var(--hair);
    display: grid;
    gap: 1rem;
  }

  .dl__license ul { display: grid; gap: 0.55rem; max-width: 62ch; }
  .dl__license-doc { color: var(--ink-38); font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.04em; }
  .dl__license-doc a { color: var(--orange); border-bottom: 1px solid transparent; transition: border-color 220ms var(--ease-out); }
  .dl__license-doc a:hover { border-color: var(--orange); }
  .dl__license-cc a { color: var(--ink-56); }

  .dl__license li {
    position: relative;
    padding-left: 1rem;
    font-size: var(--fs-small);
    color: var(--ink-56);
    line-height: 1.75;
  }

  .dl__license li::before {
    content: '';
    position: absolute;
    left: 0; top: 0.72em;
    width: 6px; height: 1px;
    background: var(--orange);
  }

  @media (max-width: 720px) {
    .dl__item { grid-template-columns: auto 1fr; }
    .dl__btn { grid-column: 2; justify-self: start; margin-top: 0.5rem; }
  }
</style>
