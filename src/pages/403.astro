---
import '../styles/global.css';
import TypedPoem from '../components/sys/TypedPoem.tsx';
import { getDict } from '../i18n';

const zh = getDict('zh');
const en = getDict('en');
const ja = getDict('ja');
const fz = zh.forbidden;
const fe = en.forbidden;
const fj = ja.forbidden;

/* 403 诗 · 两套：
   CN 命中 B（名单是我填的） · 非 CN 命中 C（门在。钥匙不在。） */
const poemZhCn = ['这个门只对一部分地区开。', '名单是我填的，填窄了。', '掉头，或者来敲一下门。', '她在页面里等你，不催。'];
const poemEnCn = [
  'This door only opens in some regions.',
  'I drew the map too small.',
  'Turn around, or come knock on the door.',
  "She's in the page, waiting.",
];
const poemZhGlobal = ['门在。钥匙不在。', '不是你按错了门。', '往回，或者叫人。', '她在里面，等你来。'];
const poemEnGlobal = [
  'The door is here. The key isn\'t.',
  "You didn't pick the wrong door.",
  'Turn back, or call someone.',
  "She's inside, waiting for you.",
];

/* 日语：和标题同一口气，不端着 */
const poemJaCn = ['この扉は、一部の地域にしか開いてない。', '地図を小さく描きすぎたのは僕のせい。', '引き返すか、ドアを叩いて。', '彼女は中で待ってる。急かさない。'];
const poemJaGlobal = ['扉はここにある。鍵がここにないだけ。', 'ドアを間違えたわけじゃない。', '戻るか、誰かを呼んで。', '彼女は中で待ってる。'];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>403 · 猫猫头网络科技</title>
    <meta name="description" content="403 — 该页面不对外公开。" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <script is:inline>
      // 地区：URL 参数 > 服务端注入的 data-region-hint > 时区启发式（拿不到就当中国）
      // 语言：URL 参数 > 服务端注入 > 浏览器语言
      (function () {
        var root = document.documentElement;
        var region = 'cn';
        var locale = 'zh';

        try {
          var params = new URLSearchParams(location.search);
          var qRegion = params.get('region');
          var qLang = params.get('lang');

          if (qRegion === 'cn' || qRegion === 'jp' || qRegion === 'global') {
            region = qRegion;
          } else if (root.dataset.regionHint) {
            region = root.dataset.regionHint;
          } else {
            var tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
            if (/^Asia\/(Shanghai|Chongqing|Harbin|Urumqi|Kashgar)$/.test(tz)) {
              region = 'cn';
            } else if (tz === 'Asia/Tokyo') {
              region = 'jp';
            } else {
              region = 'global';
            }
          }

          if (qLang === 'en' || qLang === 'zh' || qLang === 'ja' || qLang === 'yue') {
            locale = qLang;
          } else if (root.dataset.localeHint) {
            locale = root.dataset.localeHint;
          } else {
            var nav = (navigator.language || 'zh').toLowerCase();
            locale = nav.indexOf('zh') === 0 ? 'zh' : nav.indexOf('ja') === 0 ? 'ja' : 'en';
          }
        } catch (e) {
          region = 'cn';
          locale = 'zh';
        }

        // 路径前缀 /ja/ 优先于浏览器语言
        if (location.pathname.indexOf('/ja') === 0) locale = 'ja';

        root.dataset.region = region;
        root.dataset.locale = locale;
      })();
    </script>
  </head>

  <body class="fb">
    <main class="fb__inner">
      <div class="fb__brand">
        <img src="/brand/mark_primary.svg" alt="猫猫头网络科技" width="30" height="30" />
        <span class="mono fb__brand-name">MAOMAO / 403</span>
      </div>

      <p class="mono fb__label">{fz.label}</p>

      <h1 class="fb__title" data-lang="zh" data-region-cn>{fz.titleCn}</h1>
      <h1 class="fb__title" data-lang="zh" data-region-jp>{fz.titleJp}</h1>
      <h1 class="fb__title" data-lang="zh" data-region-global>{fz.titleGlobal}</h1>
      <h1 class="fb__title" data-lang="en" data-region-cn>{fe.titleCn}</h1>
      <h1 class="fb__title" data-lang="en" data-region-jp>{fe.titleJp}</h1>
      <h1 class="fb__title" data-lang="en" data-region-global>{fe.titleGlobal}</h1>
      <h1 class="fb__title" data-lang="ja" data-region-cn>{fj.titleCn}</h1>
      <h1 class="fb__title" data-lang="ja" data-region-jp>{fj.titleJp}</h1>
      <h1 class="fb__title" data-lang="ja" data-region-global>{fj.titleGlobal}</h1>

      <p class="fb__body" data-lang="zh" data-region-cn>{fz.bodyCn}</p>
      <p class="fb__body" data-lang="zh" data-region-jp>{fz.bodyJp}</p>
      <p class="fb__body" data-lang="zh" data-region-global>{fz.bodyGlobal}</p>
      <p class="fb__body" data-lang="en" data-region-cn>{fe.bodyCn}</p>
      <p class="fb__body" data-lang="en" data-region-jp>{fe.bodyJp}</p>
      <p class="fb__body" data-lang="en" data-region-global>{fe.bodyGlobal}</p>
      <p class="fb__body" data-lang="ja" data-region-cn>{fj.bodyCn}</p>
      <p class="fb__body" data-lang="ja" data-region-jp>{fj.bodyJp}</p>
      <p class="fb__body" data-lang="ja" data-region-global>{fj.bodyGlobal}</p>

      <div class="fb__poem">
        <TypedPoem
          client:idle
          linesZh={poemZhCn}
          linesEn={poemEnCn}
          linesZhAlt={poemZhGlobal}
          linesEnAlt={poemEnGlobal}
          linesJa={poemJaCn}
          linesJaAlt={poemJaGlobal}
          ariaLabel="403 诗：这个门只对一部分地区开。名单是我填的，填窄了。掉头，或者来敲一下门。她在页面里等你，不催。"
        />
      </div>

      <div class="fb__actions" data-lang="zh">
        <a class="fb__btn fb__btn--solid" href={fz.home.href}>{fz.home.label}</a>
        <a class="fb__btn" href={fz.mascot.href}>{fz.mascot.label}</a>
      </div>
      <div class="fb__actions" data-lang="en">
        <a class="fb__btn fb__btn--solid" href={fe.home.href}>{fe.home.label}</a>
        <a class="fb__btn" href={fe.mascot.href}>{fe.mascot.label}</a>
      </div>
      <div class="fb__actions" data-lang="ja">
        <a class="fb__btn fb__btn--solid" href={fj.home.href}>{fj.home.label}</a>
        <a class="fb__btn" href={fj.mascot.href}>{fj.mascot.label}</a>
      </div>

      <p class="fb__note mono-sm" data-lang="zh">{fz.note}</p>
      <p class="fb__note mono-sm" data-lang="en">{fe.note}</p>
      <p class="fb__note mono-sm" data-lang="ja">{fj.note}</p>
    </main>
  </body>
</html>

<style>
  /* 语言 / 地区切换：用 !important 压过组件自身的 display */
  html:not([data-locale='en']) [data-lang='en'],
  html:not([data-locale='ja']) [data-lang='ja'] {
    display: none !important;
  }

  html[data-locale='en'] [data-lang='zh'],
  html[data-locale='en'] [data-lang='ja'],
  html[data-locale='ja'] [data-lang='zh'],
  html[data-locale='ja'] [data-lang='en'] {
    display: none !important;
  }

  html[data-locale='ja'] [data-lang='ja'] {
    display: revert !important;
  }

  html:not([data-region='global']) [data-region-global],
  html:not([data-region='cn']) [data-region-cn],
  html:not([data-region='jp']) [data-region-jp] {
    display: none !important;
  }

  html[data-region='global'] [data-region-cn],
  html[data-region='global'] [data-region-jp],
  html[data-region='jp'] [data-region-cn],
  html[data-region='jp'] [data-region-global],
  html[data-region='cn'] [data-region-jp],
  html[data-region='cn'] [data-region-global] {
    display: none !important;
  }

  .fb {
    margin: 0;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: clamp(1.5rem, 6vw, 4rem);
    background: var(--cream);
    color: var(--ink);
    font-family: var(--font-sans);
  }

  .fb__inner {
    width: min(680px, 100%);
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .fb__brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: clamp(0.5rem, 2vw, 1.5rem);
  }

  .fb__brand-name {
    color: var(--ink-38);
    font-size: 0.5rem;
    letter-spacing: 0.2em;
  }

  .fb__label {
    color: var(--orange);
    font-size: 0.5625rem;
    letter-spacing: 0.18em;
  }

  .fb__title {
    font-family: var(--font-cjk);
    font-size: clamp(1.75rem, 4.6vw, 3.25rem);
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: -0.025em;
    max-width: 18ch;
    margin: 0;
  }

  .fb__body {
    margin: 0;
    max-width: 42ch;
    color: var(--ink-56);
    font-size: var(--fs-small);
    line-height: 1.85;
  }

  .fb__poem {
    margin: clamp(1rem, 3vw, 2rem) 0 clamp(0.5rem, 2vw, 1rem);
    width: 100%;
    padding-top: clamp(1rem, 2.5vw, 1.5rem);
    border-top: 1px solid var(--ink-12);
  }

  .fb__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }

  .fb__btn {
    display: inline-flex;
    align-items: center;
    padding: 0.8em 1.35em;
    border-radius: 999px;
    border: 1px solid var(--ink-20);
    font-size: var(--fs-small);
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
    transition:
      background-color 220ms var(--ease-out),
      color 220ms var(--ease-out),
      border-color 220ms var(--ease-out);
  }

  .fb__btn:hover {
    border-color: var(--ink);
  }

  .fb__btn--solid {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--cream);
  }

  .fb__btn--solid:hover {
    background: var(--orange);
    border-color: var(--orange);
  }

  .fb__note {
    margin: 0.75rem 0 0;
    color: var(--ink-38);
    text-transform: none;
    letter-spacing: 0.04em;
    font-size: 0.625rem;
    line-height: 1.7;
  }

  /* 403 诗的 token 样式复用的全局 .poem，这里只补字号 */
  :global(.fb .poem__line) {
    font-size: clamp(1.125rem, 2.6vw, 1.75rem);
  }
</style>
